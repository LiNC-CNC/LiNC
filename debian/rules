#!/usr/bin/make -f
# Native source build: dpkg-buildpackage. For cross builds (aarch64 on amd64)
# use scripts/build-deb.sh, which drives cargo per target and stages the tree
# itself.
%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked

override_dh_auto_test:
	cargo test --release --workspace --locked

override_dh_auto_install:
	install -Dm755 target/release/linc debian/linc/usr/bin/linc
	install -Dm755 target/release/linc-panel debian/linc/usr/bin/linc-panel
	install -Dm755 target/release/linc-mcp debian/linc/usr/bin/linc-mcp
	install -d debian/linc/usr/share/linc/configs debian/linc/usr/share/linc/hal
	install -d debian/linc/usr/share/linc/subroutines
	# base.toml is the default table of the binary in this package; a machine
	# profile extends it from its own config directory. The simulation profiles
	# and the desktop entry stay in the source checkout: they are development
	# tooling, not machine data.
	install -m644 configs/base.toml debian/linc/usr/share/linc/configs/
	install -m644 hal/*.hal debian/linc/usr/share/linc/hal/
	cp -a subroutines/probe_basic debian/linc/usr/share/linc/subroutines/
	install -Dm644 assets/branding/linc-icon-256.png debian/linc/usr/share/icons/hicolor/256x256/apps/linc.png
	install -Dm644 README.md debian/linc/usr/share/doc/linc/README.md
	install -Dm644 debian/copyright debian/linc/usr/share/doc/linc/copyright

override_dh_auto_clean:
	dh_auto_clean
	rm -rf target/release target/debug
