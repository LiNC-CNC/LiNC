# LiNC lathe post-GUI wiring.
#
# Loaded by linc-display after the linc GUI has created its linc.* component.
# The mill simulation's post-GUI file also nets cnc_panel.probe to the software
# FPGA (rio.sim-probe); the lathe has no such component, so it has its own file.

# Two-digit panel status display: active WCS from linc, 54-59 or --.
net linc-status linc.status-display => cnc_panel.sseg_status

# Manual tool-change acknowledgement from the HMI. Probe Basic's core_sim HAL
# already creates `tool-change-confirmed => iocontrol.0.tool-changed`; attach
# the HMI's pulse as that signal's driver instead of linking the pin twice.
net tool-change-confirmed linc.tool-change-confirm

# UI heartbeat. A machine/PLC watchdog may consume this signal.
net linc-hmi-heartbeat linc.hmi-alive

# Jog speed, scaled in the HMI from [DISPLAY] DEFAULT_LINEAR_VELOCITY.
net jog-speed linc.jog-speed => halui.axis.jog-speed halui.joint.jog-speed

# Jog step for INC mode, selected in the HMI from [DISPLAY] INCREMENTS.
net jog-increment linc.jog-increment => halui.axis.x.increment halui.axis.z.increment
