# LiNC simulation post-GUI wiring.
#
# Loaded by linc-display after the linc GUI has created its linc.* component.
# The reference simulation already owns iocontrol.0.tool-changed through the
# `tool-changed` signal; the HMI pulses that signal only after a validated
# manual tool-change acknowledgement.

net linc-status linc.status-display => cnc_panel.sseg_status
net tool-changed linc.tool-change-confirm
net linc-hmi-heartbeat linc.hmi-alive

# A latched probe trip switches the machine off: halui refuses a jog unless the
# task state is ON, and the panel jogs straight into halui. The level is ORed
# with the POWER OFF key onto the single halui.machine.off pin. It is held until
# the trip is reset, so halui's rising edge switches the machine off once and a
# re-power is not undone.
net linc-machine-off linc.machine-off => or2.machine_off.in1
# Jog speed, scaled in the HMI from [DISPLAY] DEFAULT_LINEAR_VELOCITY.
net jog-speed linc.jog-speed => halui.axis.jog-speed halui.joint.jog-speed

# Jog step for INC mode, selected in the HMI from [DISPLAY] INCREMENTS.
net jog-increment linc.jog-increment => halui.axis.x.increment halui.axis.y.increment halui.axis.z.increment

# Simulated probe contact: the PROBE key on the panel drives rio.sim-probe
# (rio_sim.py turns it into sig_rio_probe_bit). motion.probe-input is driven by
# hal/linc-sim3d.hal, which ORs that bit with the 3D simulator's probe-out; no
# probe input is linked here.
net sim-probe cnc_panel.probe => rio.sim-probe
