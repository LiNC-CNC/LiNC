#################################################################################
# joint-0  (Option B: PID over motor encoder rio.encoder-x.position)
#################################################################################
setp pid.0.Pgain                   [JOINT_0]P
setp pid.0.Igain                   [JOINT_0]I
setp pid.0.Dgain                   [JOINT_0]D
setp pid.0.bias                    [JOINT_0]BIAS
setp pid.0.FF0                     [JOINT_0]FF0
setp pid.0.FF1                     [JOINT_0]FF1
setp pid.0.FF2                     [JOINT_0]FF2
setp pid.0.deadband                [JOINT_0]DEADBAND
setp pid.0.maxoutput               [JOINT_0]MAXOUTPUT
setp rio.x-joint.velocity-scale    [JOINT_0]SCALE
net j0vel-cmd                      <= pid.0.output
net j0pos-cmd                      <= joint.0.motor-pos-cmd
net j0enable                       <= joint.0.amp-enable-out
net j0vel-cmd                      => rio.x-joint.velocity
# simulated servo: no drive and no encoder, the axis follows its command rigidly,
# so the command signal itself is the feedback - and the input of the simulated
# card, which derives rio.encoder-x.position, rio.home-x.bit and the limits from it
net j0pos-cmd                      => joint.0.motor-pos-fb
net j0pos-cmd                      => pid.0.command
net j0pos-cmd                      => rio.sim-pos-x
net j0enable                       => rio.x-joint.enable
net j0enable                       => pid.0.enable

#################################################################################
# joint-1  (Option B: PID over motor encoder rio.encoder-y.position)
#################################################################################
setp pid.1.Pgain                   [JOINT_1]P
setp pid.1.Igain                   [JOINT_1]I
setp pid.1.Dgain                   [JOINT_1]D
setp pid.1.bias                    [JOINT_1]BIAS
setp pid.1.FF0                     [JOINT_1]FF0
setp pid.1.FF1                     [JOINT_1]FF1
setp pid.1.FF2                     [JOINT_1]FF2
setp pid.1.deadband                [JOINT_1]DEADBAND
setp pid.1.maxoutput               [JOINT_1]MAXOUTPUT
setp rio.y-joint.velocity-scale    [JOINT_1]SCALE
net j1vel-cmd                      <= pid.1.output
net j1pos-cmd                      <= joint.1.motor-pos-cmd
net j1enable                       <= joint.1.amp-enable-out
net j1vel-cmd                      => rio.y-joint.velocity
# rigid simulated axis - see the joint-0 block above
net j1pos-cmd                      => joint.1.motor-pos-fb
net j1pos-cmd                      => pid.1.command
net j1pos-cmd                      => rio.sim-pos-y
net j1enable                       => rio.y-joint.enable
net j1enable                       => pid.1.enable

#################################################################################
# joint-2  (Option B: PID over motor encoder rio.encoder-z.position)
#################################################################################
setp pid.2.Pgain                   [JOINT_2]P
setp pid.2.Igain                   [JOINT_2]I
setp pid.2.Dgain                   [JOINT_2]D
setp pid.2.bias                    [JOINT_2]BIAS
setp pid.2.FF0                     [JOINT_2]FF0
setp pid.2.FF1                     [JOINT_2]FF1
setp pid.2.FF2                     [JOINT_2]FF2
setp pid.2.deadband                [JOINT_2]DEADBAND
setp pid.2.maxoutput               [JOINT_2]MAXOUTPUT
setp rio.z-joint.velocity-scale    [JOINT_2]SCALE
net j2vel-cmd                      <= pid.2.output
net j2pos-cmd                      <= joint.2.motor-pos-cmd
net j2enable                       <= joint.2.amp-enable-out
net j2vel-cmd                      => rio.z-joint.velocity
# rigid simulated axis - see the joint-0 block above
net j2pos-cmd                      => joint.2.motor-pos-fb
net j2pos-cmd                      => pid.2.command
net j2pos-cmd                      => rio.sim-pos-z
net j2enable                       => rio.z-joint.enable
net j2enable                       => pid.2.enable

#################################################################################
# setp
#################################################################################
# Encoder feedback scale (counts per mm), sign set so +axis motion -> +feedback.
# Measured: Y = 500 counts/mm (reversed polarity), Z = 250 counts/mm (reversed).
# X A/B not wired yet; using Y's 500 counts/mm as a closer default than 2500.
setp rio.encoder-x.position-scale     -500
setp rio.encoder-y.position-scale     -500
setp rio.encoder-z.position-scale     -250
setp rio.spindle-encoder.position-scale   1024.0
setp rio.spindle.dty-scale            0.00833

#################################################################################
# preformated
#################################################################################
net rios.spindle-encoder.indexenable rio.spindle-encoder.indexenable <=> spindle.0.index-enable

# Joint encoder index-enable (homing to encoder index pulse)
net x-index-enable joint.0.index-enable <=> rio.encoder-x.indexenable
net y-index-enable joint.1.index-enable <=> rio.encoder-y.indexenable
net z-index-enable joint.2.index-enable <=> rio.encoder-z.indexenable

#################################################################################
# Simulation-only inputs of rio_sim.py
#################################################################################
# These pins do not exist on the real card driver; the sim synthesises the
# hardware state from them:
#
#   rio.sim-pos-x|y|z     true axis position (mm) -> encoder / limit / home sw
#   rio.sim-estop         E-stop mushroom, driven by the panel (see postgui)
#   rio.sim-probe         probe contact, driven by the GUI (see postgui)
#   rio.sim-power-on/off  machine POWER ON/OFF buttons (see postgui); latched
#                         into rio.machine-on-switch.bit
#   rio.sim-home-pos-x|y|z, rio.sim-home-window, rio.sim-lim-margin,
#   rio.sim-index-dist-x|y|z
#                         hardware geometry of the simulated machine; 0 = default
#
# sim-pos-* is netted inside the joint-N blocks above; the rest are wired in
# hallib/probe_basic_postgui.hal (they need pins created by the panel GUI).
