# LiNC core HAL wiring (pre-GUI)
#
# Requirements:
#   * LINC_CONFIG is exported in the LinuxCNC environment and selects the same
#     profile used by the linc GUI.
#   * linc-panel is installed and creates the cnc_panel HAL component.
#   * The machine HAL provides rio.probe.bit, rio.worklamp.bit and
#     rio.tool-change.bit; adjust those names to the actual machine I/O.
#
# The linc GUI creates the linc.* output component after it starts. Wire those
# pins in linc-postgui.hal.

# --no-ipc: under LinuxCNC all panel state travels through cnc_panel.* HAL pins.
loadusr -Wn cnc_panel linc-panel --no-ipc

# ---------------------------------------------------------------------------
# Logic and conversion components
# ---------------------------------------------------------------------------
loadrt and2 names=and2.cycle_gate,and2.cycle_run,and2.cycle_resume,and2.jxp_cont,and2.jxn_cont,and2.jyp_cont,and2.jyn_cont,and2.jzp_cont,and2.jzn_cont,and2.jxp_inc,and2.jxn_inc,and2.jyp_inc,and2.jyn_inc,and2.jzp_inc,and2.jzn_inc
# `or2` is loaded once here; a second `loadrt or2` in another HAL file fails
# with "or2: already exists". Instances only used by the simulation
# (or2.estop_reset) are created here and wired in linc-sim.hal.
loadrt or2 names=or2.jog_a,or2.jog_b,or2.pause,or2.manual_req,or2.estop_reset
loadrt not names=not.paused,not.coolant,not.lube,not.opt,not.bdt,not.spindle_on,not.mode_inc
loadrt toggle names=toggle.coolant,toggle.lube,toggle.opt,toggle.bdt,toggle.sbk,toggle.worklamp
loadrt scale names=scale.feed,scale.rapid,scale.spindle
loadrt conv_float_s32 names=conv.feed,conv.rapid,conv.spindle

addf and2.cycle_gate servo-thread
addf and2.cycle_run servo-thread
addf and2.cycle_resume servo-thread
addf and2.jxp_cont servo-thread
addf and2.jxn_cont servo-thread
addf and2.jyp_cont servo-thread
addf and2.jyn_cont servo-thread
addf and2.jzp_cont servo-thread
addf and2.jzn_cont servo-thread
addf and2.jxp_inc servo-thread
addf and2.jxn_inc servo-thread
addf and2.jyp_inc servo-thread
addf and2.jyn_inc servo-thread
addf and2.jzp_inc servo-thread
addf and2.jzn_inc servo-thread
addf not.mode_inc servo-thread
addf or2.jog_a servo-thread
addf or2.jog_b servo-thread
addf or2.manual_req servo-thread
addf or2.pause servo-thread
addf not.paused servo-thread
addf not.coolant servo-thread
addf not.lube servo-thread
addf not.opt servo-thread
addf not.bdt servo-thread
addf not.spindle_on servo-thread
addf toggle.coolant servo-thread
addf toggle.lube servo-thread
addf toggle.opt servo-thread
addf toggle.bdt servo-thread
addf toggle.sbk servo-thread
addf toggle.worklamp servo-thread
addf scale.feed servo-thread
addf scale.rapid servo-thread
addf scale.spindle servo-thread
addf conv.feed servo-thread
addf conv.rapid servo-thread
addf conv.spindle servo-thread

setp scale.feed.gain 100
setp scale.rapid.gain 100
setp scale.spindle.gain 100
setp conv.feed.clamp true
setp conv.rapid.clamp true
setp conv.spindle.clamp true

# ---------------------------------------------------------------------------
# Panel modes
# ---------------------------------------------------------------------------
net mode-auto cnc_panel.mode_auto => halui.mode.auto
net mode-mdi cnc_panel.mode_mdi => halui.mode.mdi
net mode-jog cnc_panel.mode_jog => or2.jog_a.in0
# `cnc_panel.mode_inc` is a pin, so it carries exactly one signal; every INC
# consumer is a reader on it.
net mode-inc cnc_panel.mode_inc => or2.jog_a.in1 not.mode_inc.in and2.jxp_inc.in1 and2.jxn_inc.in1 and2.jyp_inc.in1 and2.jyn_inc.in1 and2.jzp_inc.in1 and2.jzn_inc.in1
net mode-mpg cnc_panel.mode_mpg => or2.jog_b.in0
net mode-jog-a or2.jog_a.out => or2.jog_b.in1
# JOG / INC / MPG jog the machine, so they must also select the MANUAL task
# mode: `halui.axis.L.plus/minus` (EMC_AXIS_JOG) is refused unless the task
# mode is MANUAL. Teleop is requested as well because axis jogging runs
# through the teleop planner.
#
# `halui.mode.manual` is a single pin, so JOG and HOME are ORed into one
# request rather than each linking the pin themselves.
net mode-jog-any or2.jog_b.out => halui.mode.teleop or2.manual_req.in0

# EDIT, HOME and PROG.HOME are not LinuxCNC task modes, but HOME must still put
# the controller into MANUAL: `halui.joint.N.home` / `halui.home-all` are
# refused with "can't do that (EMC_JOINT_HOME) in auto mode" whenever the task
# mode is AUTO or MDI. Selecting HOME on the panel is an explicit request to
# leave AUTO, exactly like turning the real selector away from AUTO.
#
# PROG.HOME is deliberately NOT wired here: it issues its G0 through the
# panel/LiNC issue_mdi path, which selects MDI itself, and asserting MANUAL
# would fight that switch.
# HOME also drops motion out of teleop. Jogging asserts `halui.mode.teleop`, and
# motion refuses `EMC_JOINT_HOME` with "must be in joint mode to home" while it
# is teleop — `halui.mode.joint` sends EMC_TRAJ_SET_TELEOP_ENABLE(0), which is
# MOTION_FREE. Manual mode alone does not.
net mode-manual-home cnc_panel.mode_home => or2.manual_req.in1 halui.mode.joint
net mode-manual-request or2.manual_req.out => halui.mode.manual

# ---------------------------------------------------------------------------
# Cycle start / pause / stop
# ---------------------------------------------------------------------------
net is-auto halui.mode.is-auto => and2.cycle_gate.in0
net is-paused halui.program.is-paused => not.paused.in and2.cycle_resume.in0
net not-paused not.paused.out => and2.cycle_gate.in1
net cycle-gate and2.cycle_gate.out => and2.cycle_run.in0
net cycle-start cnc_panel.cycle_start => and2.cycle_run.in1 and2.cycle_resume.in1
net cycle-run and2.cycle_run.out => halui.program.run

net cycle-resume and2.cycle_resume.out => halui.program.resume

net cycle-stop cnc_panel.cycle_stop => or2.pause.in1
net sbk-mode toggle.sbk.out => or2.pause.in0 cnc_panel.led_sbk
net pause-request or2.pause.out => halui.program.pause
net single-block-step cnc_panel.step => halui.program.step

net sbk-button cnc_panel.sbk => toggle.sbk.in

net k4-stop cnc_panel.k4 => halui.program.stop

# Block delete
net bdt-button cnc_panel.bdt => toggle.bdt.in
net bdt-on toggle.bdt.out => halui.program.block-delete.on not.bdt.in
net bdt-off not.bdt.out => halui.program.block-delete.off
net bdt-status halui.program.block-delete.is-on => cnc_panel.led_bdt

# Optional stop
net opt-button cnc_panel.opt => toggle.opt.in
net opt-on toggle.opt.out => halui.program.optional-stop.on not.opt.in
net opt-off not.opt.out => halui.program.optional-stop.off
net opt-status halui.program.optional-stop.is-on => cnc_panel.led_opt

# ---------------------------------------------------------------------------
# Spindle
# ---------------------------------------------------------------------------
net spindle-cw cnc_panel.spd_cw => halui.spindle.0.forward
net spindle-ccw cnc_panel.spd_ccw => halui.spindle.0.reverse
net spindle-stop cnc_panel.spd_sp => halui.spindle.0.stop

# spindle.0.orient is a status output from motmod, not a request input.
# Wire the panel orient button to the machine-specific orient command (for
# example an INI halui MDI command) rather than to spindle.0.orient.
net spindle-oriented spindle.0.orient => cnc_panel.led_spd_ori

net spindle-on halui.spindle.0.is-on => not.spindle_on.in
net spindle-off not.spindle_on.out => cnc_panel.led_spd_sp
net spindle-forward halui.spindle.0.runs-forward => cnc_panel.led_spd_cw
net spindle-reverse halui.spindle.0.runs-backward => cnc_panel.led_spd_ccw

# ---------------------------------------------------------------------------
# Coolant, lube, work lamp
# ---------------------------------------------------------------------------
net coolant-button cnc_panel.coolant => toggle.coolant.in
net coolant-on toggle.coolant.out => halui.flood.on not.coolant.in
net coolant-off not.coolant.out => halui.flood.off
net coolant-status halui.flood.is-on => cnc_panel.led_coolant

net lube-button cnc_panel.lube => toggle.lube.in
net lube-on toggle.lube.out => halui.lube.on not.lube.in
net lube-off not.lube.out => halui.lube.off
net lube-status halui.lube.is-on => cnc_panel.led_lub

net worklamp-button cnc_panel.worklamp => toggle.worklamp.in
net worklamp-on toggle.worklamp.out => rio.worklamp.bit cnc_panel.led_worklamp

# ---------------------------------------------------------------------------
# Jog speed. `halui.axis.jog-speed` defaults to 0, so without a value the jog
# buttons hold the pins high and the machine does not move at all. The HMI
# publishes the INI's default linear velocity scaled by the operator's
# percentage on `linc.jog-speed`; that net is in the post-GUI file because the
# linc.* component only exists once the GUI has started.

# Jog buttons (panel; pendant jog is wired in linc-pendant.hal)
#
# The panel has no increment selector, so the HMI publishes the chosen step on
# `linc.jog-increment` (from [DISPLAY] INCREMENTS in the machine INI, the same
# list Axis and Probe Basic offer). That net lives in the post-GUI file: the
# linc.* component only exists once the GUI has started. `halui.axis.L.increment`
# reads 0.0 until then, which is continuous jog.
#
# Jog keys are routed by panel mode: JOG and MPG jog continuously, and
# `halui.axis.L.plus/minus` are level inputs. INC jogs one step per press, and
# `halui.axis.L.increment-plus/minus` are edge triggered. Both branches use
# `halui.axis.jog-speed`.
# ---------------------------------------------------------------------------
net not-inc not.mode_inc.out => and2.jxp_cont.in1 and2.jxn_cont.in1 and2.jyp_cont.in1 and2.jyn_cont.in1 and2.jzp_cont.in1 and2.jzn_cont.in1

# Continuous: JOG / MPG
net jog-xp cnc_panel.jog_xp => and2.jxp_cont.in0 and2.jxp_inc.in0
net jog-xn cnc_panel.jog_xn => and2.jxn_cont.in0 and2.jxn_inc.in0
net jog-yp cnc_panel.jog_yp => and2.jyp_cont.in0 and2.jyp_inc.in0
net jog-yn cnc_panel.jog_yn => and2.jyn_cont.in0 and2.jyn_inc.in0
net jog-zp cnc_panel.jog_zp => and2.jzp_cont.in0 and2.jzp_inc.in0
net jog-zn cnc_panel.jog_zn => and2.jzn_cont.in0 and2.jzn_inc.in0

net jog-xp-continuous and2.jxp_cont.out => halui.axis.x.plus
net jog-xn-continuous and2.jxn_cont.out => halui.axis.x.minus
net jog-yp-continuous and2.jyp_cont.out => halui.axis.y.plus
net jog-yn-continuous and2.jyn_cont.out => halui.axis.y.minus
net jog-zp-continuous and2.jzp_cont.out => halui.axis.z.plus
net jog-zn-continuous and2.jzn_cont.out => halui.axis.z.minus

# Incremental
net jog-xp-step and2.jxp_inc.out => halui.axis.x.increment-plus
net jog-xn-step and2.jxn_inc.out => halui.axis.x.increment-minus
net jog-yp-step and2.jyp_inc.out => halui.axis.y.increment-plus
net jog-yn-step and2.jyn_inc.out => halui.axis.y.increment-minus
net jog-zp-step and2.jzp_inc.out => halui.axis.z.increment-plus
net jog-zn-step and2.jzn_inc.out => halui.axis.z.increment-minus

# ---------------------------------------------------------------------------
# Homing
# ---------------------------------------------------------------------------
net home-all cnc_panel.home-all => halui.home-all
net home-x cnc_panel.home-x => halui.joint.0.home
net home-y cnc_panel.home-y => halui.joint.1.home
net home-z cnc_panel.home-z => halui.joint.2.home

# Individual home outputs are inhibited while any axis is homing. The panel
# service reads motmod home-state values (1..4 = homing) and gates
# home-x/y/z and proghome-x/y/z; it never gates home-all.
net home-state-x joint.0.home-state => cnc_panel.home_state_x
net home-state-y joint.1.home-state => cnc_panel.home_state_y
net home-state-z joint.2.home-state => cnc_panel.home_state_z

# PROG.HOME outputs are consumed by the LiNC/panel issue_mdi path, not by a
# generic HAL movement block.

# ---------------------------------------------------------------------------
# Overrides
# ---------------------------------------------------------------------------
net feed-override cnc_panel.feed_override => scale.feed.in
net feed-override-scaled scale.feed.out => conv.feed.in
net feed-override-counts conv.feed.out => halui.feed-override.counts
net rapid-override cnc_panel.rapid_override => scale.rapid.in
net rapid-override-scaled scale.rapid.out => conv.rapid.in
net rapid-override-counts conv.rapid.out => halui.rapid-override.counts
net spindle-override cnc_panel.spindle_override => scale.spindle.in
net spindle-override-scaled scale.spindle.out => conv.spindle.in
net spindle-override-counts conv.spindle.out => halui.spindle.0.override.counts

setp halui.feed-override.count-enable true
setp halui.feed-override.direct-value true
setp halui.feed-override.scale .01
setp halui.rapid-override.count-enable true
setp halui.rapid-override.direct-value true
setp halui.rapid-override.scale .01
setp halui.spindle.0.override.count-enable true
setp halui.spindle.0.override.direct-value true
setp halui.spindle.0.override.scale .01

# ---------------------------------------------------------------------------
# Status LEDs and tool displays
# ---------------------------------------------------------------------------
net sig_halui_machine_is-on => cnc_panel.led_ready
net program-running halui.program.is-running => cnc_panel.led_run cnc_panel.led_cycle_on cnc_panel.led_k4
net is-paused => cnc_panel.led_cycle_off
net machine-estop halui.estop.is-activated => cnc_panel.led_mc_alarm

net axis-x-homed halui.joint.0.is-homed => cnc_panel.led_x
net axis-y-homed halui.joint.1.is-homed => cnc_panel.led_y
net axis-z-homed halui.joint.2.is-homed => cnc_panel.led_z

net rapid-button cnc_panel.rapid => cnc_panel.led_rapid
net tool-change => cnc_panel.led_chuck
net tool-prep-number cnc_panel.sseg_magtool
net tool-number iocontrol.0.tool-number => cnc_panel.sseg_spdtool

# Panel emergency stop
#
# cnc_panel.estop already reaches the controller through the machine HAL:
#   sim:  linc-sim.hal -> rio.sim-estop -> rio_sim.py -> rio.estop-in.bit
#         -> sig_rio_estop-in_bit -> halui.estop.activate
#   real: the panel mushroom is part of the hardware E-stop chain.
# Do NOT link halui.estop.activate here: a HAL pin takes exactly one signal and
# the machine HAL owns that one.

# ---------------------------------------------------------------------------
# Probe input and manual tool-change/panel I/O
# ---------------------------------------------------------------------------
net sig_rio_probe_bit => motion.probe-input
net tool-change-piston cnc_panel.chuck => rio.tool-change.bit

# Adjust or remove the rio.* nets to match the actual machine I/O.

