# LiNC post-GUI HAL wiring
#
# Loaded only after the linc GUI has created its linc.* HAL component.
# This is the only place where the HMI's declared outputs are connected.

# Two-digit panel status display: active WCS from linc, 54-59 or --.
net linc-status linc.status-display => cnc_panel.sseg_status

# Manual tool-change acknowledgement: operator pressed CONFIRM INSTALLED.
# The linc backend only pulses this after validating a pending manual change.
net linc-tool-confirm linc.tool-change-confirm => iocontrol.0.tool-changed

# UI heartbeat. A machine/PLC watchdog may consume this signal; it is not used
# to drive motion or panel controls.
net linc-hmi-heartbeat linc.hmi-alive

# The program interlock. A file with a syntax fault is not loaded into the
# interpreter, and a program that is not loaded must not start, so the panel's
# CYCLE START and RESUME are gated on this level. It is created by the HMI, which
# is why the net lives here and not in the machine HAL; an unconnected input
# reads FALSE, so the gate is closed until the HMI has looked at the program.
net linc-program-ok linc.program-ok => and2.cycle_permit.in1 and2.resume_permit.in1

# Jog speed, scaled in the HMI from [DISPLAY] DEFAULT_LINEAR_VELOCITY.
net jog-speed linc.jog-speed => halui.axis.jog-speed halui.joint.jog-speed

# Jog step for INC mode, selected in the HMI from [DISPLAY] INCREMENTS.
# The step feeds both jog families: motion may sit in joint/FREE mode (where
# halui.joint.N.increment-plus/minus jog) or in teleop (where
# halui.axis.L.increment-plus/minus do), and halui.joint.N.increment defaulting
# to 0 is what made INC look dead after homing.
net jog-increment linc.jog-increment => halui.axis.x.increment halui.axis.y.increment halui.axis.z.increment halui.joint.0.increment halui.joint.1.increment halui.joint.2.increment
