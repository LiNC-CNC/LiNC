# LiNC WHB04B-6 pendant wiring (real machine only)
#
# The pendant is a JOG input only. Its mode, cycle, spindle, coolant,
# override, program, macro and probe controls are intentionally not wired.
# The complete jog path -- axis selection, enable, counts, scale and
# vel-mode -- is gated by the physical panel's JOG mode.

loadusr -W xhc-whb04b-6 -HsfB

loadrt and2 names=and2.pendant_x,and2.pendant_y,and2.pendant_z
loadrt and2 names=and2.pendant_x_select,and2.pendant_y_select,and2.pendant_z_select
loadrt and2 names=and2.pendant_x_vel,and2.pendant_y_vel,and2.pendant_z_vel
loadrt conv_s32_float names=conv.pendant_x_counts,conv.pendant_y_counts,conv.pendant_z_counts
loadrt conv_float_s32 names=conv.pendant_x_counts_out,conv.pendant_y_counts_out,conv.pendant_z_counts_out
loadrt mux2 names=mux.pendant_x_counts,mux.pendant_y_counts,mux.pendant_z_counts
loadrt mux2 names=mux.pendant_x_scale,mux.pendant_y_scale,mux.pendant_z_scale

addf and2.pendant_x servo-thread
addf and2.pendant_y servo-thread
addf and2.pendant_z servo-thread
addf and2.pendant_x_select servo-thread
addf and2.pendant_y_select servo-thread
addf and2.pendant_z_select servo-thread
addf and2.pendant_x_vel servo-thread
addf and2.pendant_y_vel servo-thread
addf and2.pendant_z_vel servo-thread
addf conv.pendant_x_counts servo-thread
addf conv.pendant_y_counts servo-thread
addf conv.pendant_z_counts servo-thread
addf conv.pendant_x_counts_out servo-thread
addf conv.pendant_y_counts_out servo-thread
addf conv.pendant_z_counts_out servo-thread
addf mux.pendant_x_counts servo-thread
addf mux.pendant_y_counts servo-thread
addf mux.pendant_z_counts servo-thread
addf mux.pendant_x_scale servo-thread
addf mux.pendant_y_scale servo-thread
addf mux.pendant_z_scale servo-thread

# Axis selection does not initiate motion, but it is part of the jog path and
# must not change LinuxCNC's selected axis outside JOG.
net pendant-x-select-raw whb.halui.axis.x.select => and2.pendant_x_select.in0
net pendant-y-select-raw whb.halui.axis.y.select => and2.pendant_y_select.in0
net pendant-z-select-raw whb.halui.axis.z.select => and2.pendant_z_select.in0
net mode-jog and2.pendant_x_select.in1
net mode-jog and2.pendant_y_select.in1
net mode-jog and2.pendant_z_select.in1
net pendant-x-select and2.pendant_x_select.out => halui.axis.x.select
net pendant-y-select and2.pendant_y_select.out => halui.axis.y.select
net pendant-z-select and2.pendant_z_select.out => halui.axis.z.select

# Handwheel enable.
net pendant-x-enable whb.axis.x.jog-enable => and2.pendant_x.in0
net pendant-y-enable whb.axis.y.jog-enable => and2.pendant_y.in0
net pendant-z-enable whb.axis.z.jog-enable => and2.pendant_z.in0
net mode-jog and2.pendant_x.in1
net mode-jog and2.pendant_y.in1
net mode-jog and2.pendant_z.in1
net pendant-x-jog and2.pendant_x.out => axis.x.jog-enable
net pendant-y-jog and2.pendant_y.out => axis.y.jog-enable
net pendant-z-jog and2.pendant_z.out => axis.z.jog-enable

# Counts are s32; convert to float for mux2 and back. Outside JOG the mux
# emits zero, so stale wheel counts cannot affect an axis after mode change.
setp mux.pendant_x_counts.in0 0
setp mux.pendant_y_counts.in0 0
setp mux.pendant_z_counts.in0 0
net pendant-x-counts-raw whb.axis.x.jog-counts => conv.pendant_x_counts.in
net pendant-y-counts-raw whb.axis.y.jog-counts => conv.pendant_y_counts.in
net pendant-z-counts-raw whb.axis.z.jog-counts => conv.pendant_z_counts.in
net pendant-x-counts-float conv.pendant_x_counts.out => mux.pendant_x_counts.in1
net pendant-y-counts-float conv.pendant_y_counts.out => mux.pendant_y_counts.in1
net pendant-z-counts-float conv.pendant_z_counts.out => mux.pendant_z_counts.in1
net mode-jog mux.pendant_x_counts.sel
net mode-jog mux.pendant_y_counts.sel
net mode-jog mux.pendant_z_counts.sel
net pendant-x-counts-muxed mux.pendant_x_counts.out => conv.pendant_x_counts_out.in
net pendant-y-counts-muxed mux.pendant_y_counts.out => conv.pendant_y_counts_out.in
net pendant-z-counts-muxed mux.pendant_z_counts.out => conv.pendant_z_counts_out.in
net pendant-x-counts conv.pendant_x_counts_out.out => axis.x.jog-counts
net pendant-y-counts conv.pendant_y_counts_out.out => axis.y.jog-counts
net pendant-z-counts conv.pendant_z_counts_out.out => axis.z.jog-counts

# Scale and velocity mode are likewise disabled outside JOG.
setp mux.pendant_x_scale.in0 0
setp mux.pendant_y_scale.in0 0
setp mux.pendant_z_scale.in0 0
net pendant-x-scale-raw whb.axis.x.jog-scale => mux.pendant_x_scale.in1
net pendant-y-scale-raw whb.axis.y.jog-scale => mux.pendant_y_scale.in1
net pendant-z-scale-raw whb.axis.z.jog-scale => mux.pendant_z_scale.in1
net mode-jog mux.pendant_x_scale.sel
net mode-jog mux.pendant_y_scale.sel
net mode-jog mux.pendant_z_scale.sel
net pendant-x-scale mux.pendant_x_scale.out => axis.x.jog-scale
net pendant-y-scale mux.pendant_y_scale.out => axis.y.jog-scale
net pendant-z-scale mux.pendant_z_scale.out => axis.z.jog-scale

net pendant-x-vel-raw whb.axis.x.jog-vel-mode => and2.pendant_x_vel.in0
net pendant-y-vel-raw whb.axis.y.jog-vel-mode => and2.pendant_y_vel.in0
net pendant-z-vel-raw whb.axis.z.jog-vel-mode => and2.pendant_z_vel.in0
net mode-jog and2.pendant_x_vel.in1
net mode-jog and2.pendant_y_vel.in1
net mode-jog and2.pendant_z_vel.in1
net pendant-x-vel and2.pendant_x_vel.out => axis.x.jog-vel-mode
net pendant-y-vel and2.pendant_y_vel.out => axis.y.jog-vel-mode
net pendant-z-vel and2.pendant_z_vel.out => axis.z.jog-vel-mode

# Do not wire:
#   whb.halui.mode.*        (mode remains on the CNC control panel)
#   whb.halui.program.*     (AUTO start/stop remains on the panel)
#   whb.halui.spindle.*     (spindle remains on the panel)
#   whb.halui.flood/mist    (coolant remains on the panel)
#   whb.halui.*override*    (overrides remain on the panel)
#   whb.button.macro-*      (macros are not part of LiNC)
