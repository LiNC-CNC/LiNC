          "text": "XIC,Motor OTE,%Q0.0",
          "comment": ""
        },
        {
          "text": "XIC,Motor TON,Delay,T#2s",
          "comment": "Running light 2 s after the motor starts."
        },
        {
          "text": "XIC,Delay.DN OTE,%Q0.1",
          "comment": ""
        },
        {
          "text": "XIO,Motor OTE,%Q0.2",
          "comment": "Stopped light."
        }
      ],
      "end_comment": ""
    }
