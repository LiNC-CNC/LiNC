            ]
          },
          "coil": {
            "var": "seal",
            "kind": "normal"
          },
          "cells": []
        },
        {
          "comment": "The seal drives the run output.",
          "logic": {
            "op": "contact",
            "var": "seal",
            "negated": false
          },
          "coil": {
            "var": "run",
            "kind": "normal"
          },
          "cells": []
        },
        {
          "comment": "Stopping while running latches the alarm.",
          "logic": {
            "op": "series",
            "items": [
              {
                "op": "contact",
                "var": "stop",
                "negated": false
              },
              {
                "op": "contact",
                "var": "run",
                "negated": false
              }
            ]
          },
